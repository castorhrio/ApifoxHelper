<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 测试目标是纯逻辑（令牌接线扫描、状态文案完备），不引用主工程：
         主工程是 net8.0-windows + WinForms，其测试宿主在 Linux 上无法启动；
         共享源码（TaskDisplay.cs）让状态断言在 Linux CI 可运行。 -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 与主工程共享同一份文件：主工程改动该文件即同时改变两边，断言始终对准真实实现。 -->
    <Compile Include="..\Desktop\Native\TaskDisplay.cs" Link="Shared\TaskDisplay.cs" />
  </ItemGroup>

</Project>
